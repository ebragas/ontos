# Ontos service configuration example
# Copy to .env for local runs and set values for one authentication mode.

# ---------------------------------------------------------------------------
# Core database and service settings
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://ontos:ontos@127.0.0.1:5432/ontos
# For non-localhost Docker/private-network Postgres without TLS, append ?sslmode=disable:
# DATABASE_URL=postgres://ontos:ontos@postgres:5432/ontos?sslmode=disable
# Optional direct connection string for publish DDL transactions (defaults to DATABASE_URL)
# DATABASE_URL_DIRECT=postgres://ontos:ontos@127.0.0.1:5432/ontos

PORT=8080
ONTOLOGY_BASE_URL=http://localhost:8080
PRODUCT_RID=ri.ontology.main.ontology.00000000-0000-4000-8000-000000000001
ONTOLOGY_ENVIRONMENT=development

# Enable the Ontology MCP server at /api/mcp (defaults to true in dev mode, false in oidc/workos)
ONTOLOGY_MCP=true

# Optional runtime flags
# ONTOS_MAX_BODY_BYTES=4194304
# LOG_REQUEST_BODIES=false
# ONTOLOGY_LOAD_DERIVED_PROPERTIES=false

# ---------------------------------------------------------------------------
# Authentication mode: dev | oidc | workos (default: workos when unset)
# ---------------------------------------------------------------------------
ONTOS_AUTH_MODE=dev

# --- Mode 1: dev (local development only; refused when ONTOLOGY_ENVIRONMENT/NODE_ENV/VERCEL_ENV is production) ---
ONTOS_DEV_TOKEN=ontos-dev-token

# --- Mode 2: oidc (any standard OIDC/JWKS identity provider) ---
# ONTOS_AUTH_MODE=oidc
# ONTOS_OIDC_ISSUER=https://idp.example.com
# ONTOS_OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# ONTOS_OIDC_AUDIENCE=ontos-api
# ONTOS_OIDC_MCP_AUDIENCE=https://ontology.example.com/api/mcp
# ONTOS_OIDC_ORG_CLAIM=org_id
# ONTOS_OIDC_DEFAULT_ORG=org_default
# ONTOS_OIDC_PERMISSIONS_CLAIM=permissions
# Publish authorization for oidc mode (configure one or more):
# ONTOS_PUBLISH_TOKEN=replace-with-high-entropy-secret
# ONTOS_PUBLISH_OIDC_ISSUER=https://token.actions.githubusercontent.com
# ONTOS_PUBLISH_OIDC_SUB=repo:owner/ontology-repo:environment:production
# ONTOS_PUBLISH_OIDC_JWKS_URI=https://token.actions.githubusercontent.com/.well-known/jwks
# ONTOS_PUBLISH_OIDC_AUDIENCE=https://ontology.example.com
# TRUSTED_GITHUB_REPOSITORY=owner/ontology-repo
# TRUSTED_GITHUB_ENVIRONMENT=ontology-production

# --- Mode 3: workos (WorkOS AuthKit + Organizations) ---
# ONTOS_AUTH_MODE=workos
# WORKOS_CLIENT_ID=client_01XXXXXXXXXXXXXXXXXXXXXXXX
# AUTHKIT_DOMAIN=auth.example.com
# WORKOS_API_KEY=sk_test_replace_me
# TRUSTED_GITHUB_REPOSITORY=owner/ontology-repo
# TRUSTED_GITHUB_ENVIRONMENT=ontology-staging

# ---------------------------------------------------------------------------
# Optional observability (OpenTelemetry OTLP, Sentry, PostHog)
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-me
# TRACES_SAMPLE_RATE=1

# SENTRY_DSN=https://public@o0.ingest.sentry.io/0
# TRACES_SENTRY=true

# TRACES_POSTHOG_REGION=us
# TRACES_POSTHOG_TOKEN=phc_replace_me
