exports[`the read statement of each member and each read compiler > ontology/ontology-sdk/object-sets#members: the metrics with no group-by have the same statement text 1`] = `
[
  {
    "text": "SELECT count(*)::double precision AS "__metric0", sum(o."amount")::double precision AS "__metric1", avg(o."amount")::double precision AS "__metric2", rtrim(rtrim(to_char(min(o."created_at") AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US'), '0'), '.') || 'Z' AS "__metric3", max(o."amount")::double precision AS "__metric4", count(DISTINCT o."status")::double precision AS "__metric5" FROM (SELECT o.* FROM "ontology_1_objects"."engagement" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $1::text) AS s)) AS o GROUP BY ()",
    "values": [
      "customer",
    ],
  },
]
`;

exports[`the read statement of each member and each read compiler > ontology/ontology-sdk/object-sets#members: union, intersect, and subtract has the same statement text 1`] = `
[
  {
    "text": "SELECT * FROM (SELECT count(*)::text AS __total FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $1::text) AS s UNION SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" = $2::text) AS s)) AS s EXCEPT SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $3::text) AS s INTERSECT SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" = $4::text) AS s)) AS s)) AS o) AS total LEFT JOIN (SELECT o."name" AS "p0", o."phase" AS "p1", o."account_id" AS "p2", o."account_id" AS "__sort0", o."account_id" COLLATE "C" AS "__order0", TRUE AS __object FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $5::text) AS s UNION SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" = $6::text) AS s)) AS s EXCEPT SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $7::text) AS s INTERSECT SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."account_id" = $8::text) AS s)) AS s)) AS o ORDER BY o."account_id" COLLATE "C" ASC NULLS FIRST LIMIT $9) AS page ON TRUE ORDER BY page."__order0" ASC NULLS FIRST",
