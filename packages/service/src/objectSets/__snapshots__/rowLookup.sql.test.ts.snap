exports[`the read statement of each member and each read compiler > ontology/ontology-sdk/object-sets#members: an orderBy and the page token of the next page have the same statement text 1`] = `
[
  {
    "text": "SELECT * FROM (SELECT count(*)::text AS __total FROM "ontology_1_objects"."engagement" AS o) AS total LEFT JOIN (SELECT o."title" AS "p0", o."engagement_id" AS "p1", o."status" AS "__sort0", o."amount" AS "__sort1", o."engagement_id" AS "__sort2", o."status" COLLATE "C" AS "__order0", o."amount" AS "__order1", o."engagement_id" COLLATE "C" AS "__order2", TRUE AS __object FROM "ontology_1_objects"."engagement" AS o ORDER BY o."status" COLLATE "C" DESC NULLS LAST, o."amount" ASC NULLS FIRST, o."engagement_id" COLLATE "C" ASC NULLS FIRST LIMIT $1) AS page ON TRUE ORDER BY page."__order0" DESC NULLS LAST, page."__order1" ASC NULLS FIRST, page."__order2" ASC NULLS FIRST",
    "values": [
      3,
    ],
  },
  {
    "text": "SELECT * FROM (SELECT count(*)::text AS __total FROM "ontology_1_objects"."engagement" AS o) AS total LEFT JOIN (SELECT o."title" AS "p0", o."engagement_id" AS "p1", o."status" AS "__sort0", o."amount" AS "__sort1", o."engagement_id" AS "__sort2", o."status" COLLATE "C" AS "__order0", o."amount" AS "__order1", o."engagement_id" COLLATE "C" AS "__order2", TRUE AS __object FROM "ontology_1_objects"."engagement" AS o WHERE (((o."status" COLLATE "C" < $1 OR o."status" COLLATE "C" IS NULL)) OR (o."status" COLLATE "C" = $1 AND o."amount" > $2) OR (o."status" COLLATE "C" = $1 AND o."amount" = $2 AND o."engagement_id" COLLATE "C" > $3)) ORDER BY o."status" COLLATE "C" DESC NULLS LAST, o."amount" ASC NULLS FIRST, o."engagement_id" COLLATE "C" ASC NULLS FIRST LIMIT $4) AS page ON TRUE ORDER BY page."__order0" DESC NULLS LAST, page."__order1" ASC NULLS FIRST, page."__order2" ASC NULLS FIRST",
    "values": [
      "won",
      12000,
      "eng-1",
      3,
    ],
  },
]
`;

exports[`the read statement of each member and each read compiler > ontology/ontology-sdk/object-sets#members: each group-by kind has the same statement text 1`] = `
[
  {
    "text": "SELECT COALESCE(o."status", $1::text) AS "__group0", count(*)::double precision AS "__metric0", max(o."amount")::double precision AS "__metric1", count(*) OVER () AS "__groups" FROM "ontology_1_objects"."engagement" AS o GROUP BY COALESCE(o."status", $1::text) ORDER BY max(o."amount") DESC NULLS LAST, COALESCE(o."status", $1::text) COLLATE "C" ASC NULLS FIRST LIMIT $2",
    "values": [
      "none",
      10000,
    ],
  },
  {
    "text": "SELECT (floor(o."amount"::numeric / $1::numeric) * $1::numeric)::double precision AS "__group0", count(*)::double precision AS "__metric0", max(o."amount")::double precision AS "__metric1", count(*) OVER () AS "__groups" FROM "ontology_1_objects"."engagement" AS o WHERE (floor(o."amount"::numeric / $1::numeric) * $1::numeric) IS NOT NULL GROUP BY (floor(o."amount"::numeric / $1::numeric) * $1::numeric) ORDER BY max(o."amount") DESC NULLS LAST, (floor(o."amount"::numeric / $1::numeric) * $1::numeric) ASC NULLS FIRST LIMIT $2",
    "values": [
      10000,
      10000,
    ],
  },
  {
    "text": "SELECT ($3::jsonb -> ("__range0".n::integer - 1)) AS "__group0", count(*)::double precision AS "__metric0", max(o."amount")::double precision AS "__metric1", count(*) OVER () AS "__groups" FROM "ontology_1_objects"."engagement" AS o JOIN unnest($1::numeric[], $2::numeric[]) WITH ORDINALITY AS "__range0"(start_value, end_value, n) ON o."amount"::numeric >= "__range0".start_value AND o."amount"::numeric < "__range0".end_value WHERE "__range0".n IS NOT NULL GROUP BY "__range0".n ORDER BY max(o."amount") DESC NULLS LAST, "__range0".n ASC NULLS FIRST LIMIT $4",
    "values": [
      [
        "0",
      ],
      [
        "10000",
      ],
      "[{"startValue":0,"endValue":10000}]",
      10000,
    ],
  },
  {
    "text": "SELECT rtrim(rtrim(to_char(date_bin($1::integer * INTERVAL '1 day', o."created_at", TIMESTAMPTZ '1970-01-01 00:00:00+00') AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US'), '0'), '.') || 'Z' AS "__group0", count(*)::double precision AS "__metric0", max(o."amount")::double precision AS "__metric1", count(*) OVER () AS "__groups" FROM "ontology_1_objects"."engagement" AS o WHERE date_bin($1::integer * INTERVAL '1 day', o."created_at", TIMESTAMPTZ '1970-01-01 00:00:00+00') IS NOT NULL GROUP BY date_bin($1::integer * INTERVAL '1 day', o."created_at", TIMESTAMPTZ '1970-01-01 00:00:00+00') ORDER BY max(o."amount") DESC NULLS LAST, date_bin($1::integer * INTERVAL '1 day', o."created_at", TIMESTAMPTZ '1970-01-01 00:00:00+00') ASC NULLS FIRST LIMIT $2",
    "values": [
      1,
      10000,
    ],
  },
]
`;

