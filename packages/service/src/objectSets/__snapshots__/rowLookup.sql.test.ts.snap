exports[`the read statement of each member and each read compiler > ontology/ontology-sdk/object-sets#members: a filter after a searchAround has the same statement text 1`] = `
[
  {
    "text": "SELECT * FROM (SELECT count(*)::text AS __total FROM (SELECT o.* FROM (SELECT o.* FROM "ontology_1_objects"."engagement" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $1::text) AS s)) AS o WHERE o."amount" < $2::double precision) AS o) AS total LEFT JOIN (SELECT o."title" AS "p0", o."amount" AS "p1", o."status" AS "p2", o."account_id" AS "p3", rtrim(rtrim(to_char(o."created_at" AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.US'), '0'), '.') || 'Z' AS "p4", o."engagement_id" AS "p5", o."engagement_id" AS "__sort0", o."engagement_id" COLLATE "C" AS "__order0", TRUE AS __object FROM (SELECT o.* FROM (SELECT o.* FROM "ontology_1_objects"."engagement" AS o WHERE o."account_id" IN (SELECT s."account_id" FROM (SELECT o.* FROM "ontology_1_objects"."account" AS o WHERE o."phase" = $3::text) AS s)) AS o WHERE o."amount" < $4::double precision) AS o ORDER BY o."engagement_id" COLLATE "C" ASC NULLS FIRST LIMIT $5) AS page ON TRUE ORDER BY page."__order0" ASC NULLS FIRST",
    "values": [
      "customer",
      40000,
      "customer",
      40000,
      1001,
    ],
  },
]
`;

